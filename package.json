{
  "name": "pi-web-desktop",
  "productName": "Pi Dsh",
  "version": "0.3.1",
  "description": "Standalone desktop application wrapping pi-web (Electron). Bundles the pi-web Next.js server and a Chromium window into a single app.",
  "license": "MIT",
  "author": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "seed": "cd runtime-seed && npm install @agegr/pi-web@latest --omit=dev --registry=https://registry.npmmirror.com",
    "seed:extensions": "cd extensions-seed && npm ci --omit=dev --registry=https://registry.npmmirror.com",
    "seed:node": "powershell -ExecutionPolicy Bypass -File scripts/seed-node.ps1",
    "seed:python": "powershell -ExecutionPolicy Bypass -File scripts/seed-python.ps1",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "test:guard": "node scripts/test-runtime-guard.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
